{
  "name": "scrap-derby",
  "version": "1.0.0",
  "private": true,
  "description": "Scrap Derby - endless car battle royale (Three.js + Capacitor)",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync android",
    "open": "npx cap open android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "aab:release": "npm run sync && cd android && ./gradlew bundleRelease",
    "serve": "npx --yes serve www"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "cordova-plugin-purchase": "^13.20.0",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0"
  }
}
