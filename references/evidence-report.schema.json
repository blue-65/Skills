{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:office-skills:evidence-report:1",
  "title": "Office deliverable verification evidence report",
  "description": "Machine-readable evidence for the exact final Office artifact. PASS requires every required gate to pass. A skipped required gate is INCONCLUSIVE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "report_id",
    "created_at",
    "verifier",
    "overall_status",
    "status_reason",
    "primary_artifact_id",
    "artifacts",
    "acceptance_checks",
    "environment",
    "reopen",
    "scan",
    "render",
    "runtime",
    "accessibility",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "type": "string",
      "enum": [
        "generic",
        "proposal",
        "rfp",
        "financial-model"
      ]
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "verifier": {
      "$ref": "#/$defs/verifier"
    },
    "overall_status": {
      "$ref": "#/$defs/gateStatus"
    },
    "status_reason": {
      "type": "string",
      "minLength": 1
    },
    "primary_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "category"
        ],
        "properties": {
          "category": {
            "const": "exact_target"
          }
        }
      },
      "minContains": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCheck"
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "reopen": {
      "$ref": "#/$defs/reopenGate"
    },
    "scan": {
      "$ref": "#/$defs/scanGate"
    },
    "render": {
      "$ref": "#/$defs/renderGate"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeGate"
    },
    "accessibility": {
      "$ref": "#/$defs/accessibilityGate"
    },
    "live_source_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/liveSourceCheck"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedItem"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "PASS"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "reopen": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "scan": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "render": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "runtime": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "accessibility": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "acceptance_checks": {
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/acceptanceCheck"
                },
                {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    },
                    "met": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "unresolved_items": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "state",
                  "delivery_blocking"
                ],
                "properties": {
                  "state": {
                    "const": "OPEN"
                  },
                  "delivery_blocking": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "REJECT"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "reopen": {
                "properties": {
                  "status": {
                    "const": "REJECT"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "scan": {
                "properties": {
                  "status": {
                    "const": "REJECT"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "render": {
                "properties": {
                  "status": {
                    "const": "REJECT"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "runtime": {
                "properties": {
                  "status": {
                    "const": "REJECT"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "accessibility": {
                "properties": {
                  "status": {
                    "const": "REJECT"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "acceptance_checks": {
                "contains": {
                  "type": "object",
                  "required": [
                    "required",
                    "status"
                  ],
                  "properties": {
                    "required": {
                      "const": true
                    },
                    "status": {
                      "const": "REJECT"
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "unresolved_items": {
                "contains": {
                  "type": "object",
                  "required": [
                    "state",
                    "delivery_blocking"
                  ],
                  "properties": {
                    "state": {
                      "const": "OPEN"
                    },
                    "delivery_blocking": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "INCONCLUSIVE"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "reopen": {
                "properties": {
                  "status": {
                    "const": "INCONCLUSIVE"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "scan": {
                "properties": {
                  "status": {
                    "const": "INCONCLUSIVE"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "render": {
                "properties": {
                  "status": {
                    "const": "INCONCLUSIVE"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "runtime": {
                "properties": {
                  "status": {
                    "const": "INCONCLUSIVE"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "accessibility": {
                "properties": {
                  "status": {
                    "const": "INCONCLUSIVE"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "acceptance_checks": {
                "contains": {
                  "type": "object",
                  "required": [
                    "required",
                    "status"
                  ],
                  "properties": {
                    "required": {
                      "const": true
                    },
                    "status": {
                      "const": "INCONCLUSIVE"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "artifacts"
        ],
        "properties": {
          "artifacts": {
            "contains": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "source_ledger"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_checks": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "category"
                  ],
                  "properties": {
                    "category": {
                      "const": "source"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "category"
                  ],
                  "properties": {
                    "category": {
                      "const": "cross_artifact"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "artifacts"
        ],
        "properties": {
          "artifacts": {
            "contains": {
              "type": "object",
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "redline"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "contains": {
              "type": "object",
              "required": [
                "role",
                "author"
              ],
              "properties": {
                "role": {
                  "const": "baseline"
                }
              }
            }
          },
          "acceptance_checks": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "category"
                  ],
                  "properties": {
                    "category": {
                      "const": "baseline"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "category"
                  ],
                  "properties": {
                    "category": {
                      "const": "cross_artifact"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "gateStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "REJECT",
        "INCONCLUSIVE"
      ]
    },
    "contentStatus": {
      "type": "string",
      "enum": [
        "verified",
        "assumption",
        "unverified"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string"
        }
      }
    },
    "artifactAuthor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization": {
          "type": "string"
        },
        "named_author": {
          "type": "string"
        },
        "metadata_author": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "path",
        "sha256",
        "size_bytes",
        "format"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "baseline",
            "source",
            "source_ledger",
            "supporting",
            "redline",
            "static_export",
            "render",
            "evidence"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_artifact_id": {
          "type": "string"
        },
        "author": {
          "$ref": "#/$defs/artifactAuthor"
        },
        "description": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "redline"
              }
            }
          },
          "then": {
            "required": [
              "source_artifact_id"
            ]
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "locale",
        "time_zone"
      ],
      "properties": {
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "time_zone": {
          "type": "string",
          "minLength": 1
        },
        "office_application": {
          "type": "string"
        },
        "office_version": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "description"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "location",
        "message"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocking",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_item_id": {
          "type": "string"
        }
      }
    },
    "acceptanceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "category",
        "required",
        "status",
        "method",
        "expected",
        "observed",
        "tolerance",
        "met",
        "evidence",
        "limitations"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "exact_target",
            "content",
            "source",
            "cross_artifact",
            "baseline",
            "customer_evidence",
            "security_evidence",
            "economic_evidence",
            "calculation",
            "layout",
            "runtime",
            "accessibility",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "observed": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "tolerance": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "number"
        },
        "difference": {
          "type": "number"
        },
        "absolute_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "relative_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "effective_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "difference_classification": {
          "type": "string",
          "enum": [
            "within_tolerance",
            "timing",
            "scope",
            "classification",
            "currency",
            "sign",
            "rounding",
            "source",
            "mapping",
            "formula",
            "unexplained",
            "not_applicable"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "target_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "page",
            "slide",
            "sheet",
            "print_page",
            "static_export"
          ]
        },
        "inventory_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "met": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "exact_target"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "required": [
              "target_artifact_id",
              "target_kind",
              "inventory_item_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "properties": {
              "met": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "REJECT",
                  "INCONCLUSIVE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "met": {
                "const": false
              },
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "reopenGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "completed",
        "method",
        "application",
        "application_version",
        "opened_artifact_id",
        "opened_path",
        "readback",
        "findings",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "completed": {
          "type": "boolean"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "application_version": {
          "type": "string",
          "minLength": 1
        },
        "opened_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "opened_path": {
          "type": "string",
          "minLength": 1
        },
        "readback": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "reason": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "required": [
              "checked_at"
            ],
            "properties": {
              "completed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              },
              "completed": {
                "const": false
              }
            },
            "required": [
              "required",
              "completed"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "status": {
                "const": "INCONCLUSIVE"
              }
            }
          }
        }
      ]
    },
    "scanGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "completed",
        "tool",
        "command",
        "scope",
        "exit_code",
        "issue_count",
        "findings",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "completed": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "required": [
              "started_at",
              "finished_at"
            ],
            "properties": {
              "completed": {
                "const": true
              },
              "exit_code": {
                "const": 0
              },
              "issue_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REJECT"
              }
            }
          },
          "then": {
            "properties": {
              "completed": {
                "const": true
              },
              "issue_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              },
              "completed": {
